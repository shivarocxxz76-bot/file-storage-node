# Application Environment Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/file_storage_db

# Session Secret Key
SESSION_SECRET=securevault_super_secret_session_key_2026

# AES-256 Encryption Key (32-character master key for file encryption at rest)
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# App Customization
APP_NAME=SecureVault
APP_TAGLINE=Web-Based Secure File Storage & Access Management System
UPLOAD_DIR=secure_storage/files
AVATAR_DIR=secure_storage/avatars
