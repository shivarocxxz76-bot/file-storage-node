<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="mb-4">
            <h4 class="fw-bold mb-1">Account & Security Settings</h4>
            <p class="text-muted small mb-0">Manage your profile, password security, and cloud storage allocation.</p>
        </div>

        <div class="row g-4">
            <!-- Left: Profile Info & Avatar -->
            <div class="col-lg-6">
                <div class="card card-custom p-4 mb-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-person-badge text-primary me-2"></i>Profile Details</h6>

                    <form method="POST" action="/profile/update" enctype="multipart/form-data">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="position-relative">
                                <% if (user.avatar && user.avatar !== 'default_avatar.png') { %>
                                    <img src="/uploads/avatars/<%= user.avatar %>" alt="Avatar" class="rounded-circle object-fit-cover border shadow-sm" style="width: 72px; height: 72px;">
                                <% } else { %>
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 72px; height: 72px;">
                                        <%= (user.full_name || 'U').charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                            </div>
                            <div class="flex-grow-1">
                                <label for="avatarInput" class="form-label small fw-semibold mb-1">Update Profile Picture</label>
                                <input type="file" name="avatar" id="avatarInput" class="form-control form-control-sm" accept="image/*">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="full_name" class="form-label fw-semibold">Full Name</label>
                            <input type="text" class="form-control" name="full_name" id="full_name" value="<%= user.full_name %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Email Address</label>
                            <input type="email" class="form-control" name="email" id="email" value="<%= user.email %>" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Account Role</label>
                            <input type="text" class="form-control bg-body-secondary text-capitalize" value="<%= user.role %>" readonly>
                        </div>

                        <button type="submit" class="btn btn-primary mt-2">
                            <i class="bi bi-save me-1"></i> Save Profile Changes
                        </button>
                    </form>
                </div>

                <!-- Storage Quota Status Card -->
                <div class="card card-custom p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart text-primary me-2"></i>Storage Quota Overview</h6>
                    
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Current Plan</span>
                        <span class="badge bg-primary-subtle text-primary fw-semibold"><%= user.storage_plan ? user.storage_plan.plan_name : 'Free Starter' %></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Usage Status</span>
                        <span class="small fw-semibold"><%= storageUsedFormatted %> of <%= storageLimitFormatted %></span>
                    </div>

                    <div class="progress mb-3" style="height: 10px;">
                        <div class="progress-bar <%= storagePercentage >= 80 ? (storagePercentage >= 100 ? 'bg-danger' : 'bg-warning') : 'bg-primary' %>" 
                             role="progressbar" 
                             style="width: <%= Math.min(100, storagePercentage) %>%;"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted"><%= storagePercentage %>% Utilized</small>
                        <a href="/storage-plans" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-arrow-up-circle me-1"></i> Upgrade Capacity
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right: Change Password & Security Safeguards -->
            <div class="col-lg-6">
                <div class="card card-custom p-4 mb-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-shield-lock text-primary me-2"></i>Change Password</h6>

                    <form method="POST" action="/profile/change-password">
                        <div class="mb-3">
                            <label for="current_password" class="form-label fw-semibold">Current Password</label>
                            <input type="password" class="form-control" name="current_password" id="current_password" required placeholder="••••••••">
                        </div>

                        <div class="mb-3">
                            <label for="new_password" class="form-label fw-semibold">New Password</label>
                            <input type="password" class="form-control" name="new_password" id="new_password" required placeholder="Min 6 characters">
                        </div>

                        <div class="mb-3">
                            <label for="confirm_password" class="form-label fw-semibold">Confirm New Password</label>
                            <input type="password" class="form-control" name="confirm_password" id="confirm_password" required placeholder="Repeat new password">
                        </div>

                        <button type="submit" class="btn btn-warning mt-2">
                            <i class="bi bi-key me-1"></i> Update Password
                        </button>
                    </form>
                </div>

                <!-- Security Checklist Card -->
                <div class="card card-custom p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-shield-check text-success me-2"></i>Security Safeguards</h6>
                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex align-items-center justify-content-between px-0">
                            <span><i class="bi bi-check-circle-fill text-success me-2"></i>AES-256-CBC Encryption at Rest</span>
                            <span class="badge bg-success-subtle text-success">Active</span>
                        </li>
                        <li class="list-group-item d-flex align-items-center justify-content-between px-0">
                            <span><i class="bi bi-check-circle-fill text-success me-2"></i>BCrypt Salted Password Hashing</span>
                            <span class="badge bg-success-subtle text-success">Active</span>
                        </li>
                        <li class="list-group-item d-flex align-items-center justify-content-between px-0">
                            <span><i class="bi bi-check-circle-fill text-success me-2"></i>SHA-256 File Integrity Checksum</span>
                            <span class="badge bg-success-subtle text-success">Active</span>
                        </li>
                        <li class="list-group-item d-flex align-items-center justify-content-between px-0">
                            <span><i class="bi bi-check-circle-fill text-success me-2"></i>Isolated Storage Outside Web Root</span>
                            <span class="badge bg-success-subtle text-success">Active</span>
                        </li>
                    </ul>
                    <div class="mt-3 text-end">
                        <a href="/activity-logs" class="text-primary text-decoration-none small fw-semibold">
                            View Full Security Activity Log &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
