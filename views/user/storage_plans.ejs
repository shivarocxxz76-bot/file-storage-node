<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="text-center mb-5">
            <h3 class="fw-bold mb-1">Expand Your Cloud Storage Quota</h3>
            <p class="text-muted small">Select an AES-256 encrypted capacity tier that meets your personal or team file storage needs.</p>
        </div>

        <div class="row g-4 justify-content-center">
            <% plans.forEach(plan => { 
                const isCurrent = currentPlanId && currentPlanId.toString() === plan._id.toString();
                const isPopular = plan.plan_name.toLowerCase().includes('pro');
            %>
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4 border <%= isPopular ? 'border-primary shadow' : '' %> position-relative">
                        <% if (isPopular) { %>
                            <span class="position-absolute top-0 start-50 translate-middle badge bg-primary px-3 py-1 rounded-pill">
                                Recommended
                            </span>
                        <% } %>

                        <div class="mb-3">
                            <h5 class="fw-bold mb-1"><%= plan.plan_name %></h5>
                            <span class="badge bg-primary-subtle text-primary text-capitalize"><%= plan.billing_cycle || 'monthly' %> Plan</span>
                        </div>

                        <div class="d-flex align-items-baseline mb-3">
                            <h2 class="fw-bold mb-0 text-primary">$<%= plan.price.toFixed(2) %></h2>
                            <span class="text-muted small ms-2">/ <%= plan.billing_cycle || 'month' %></span>
                        </div>

                        <p class="text-muted small"><%= plan.description || 'Reliable and secure high-speed file storage.' %></p>

                        <hr class="my-3">

                        <ul class="list-unstyled small mb-4">
                            <li class="mb-2"><i class="bi bi-shield-lock-fill text-primary me-2"></i> <strong><%= formatBytes(plan.storage_bytes) %></strong> Encrypted Storage</li>
                            <li class="mb-2"><i class="bi bi-file-earmark-arrow-up text-secondary me-2"></i> Max <%= formatBytes(plan.max_file_size) %> per file</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Unlimited Nested Folders</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Fast AES-256 Streaming</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Passcode Protected Signed Links</li>
                        </ul>

                        <div class="mt-auto">
                            <% if (isCurrent) { %>
                                <button class="btn btn-outline-success w-100" disabled>
                                    <i class="bi bi-check-circle me-1"></i> Current Plan
                                </button>
                            <% } else { %>
                                <a href="/checkout?plan_id=<%= plan._id %>" class="btn <%= isPopular ? 'btn-primary' : 'btn-outline-primary' %> w-100">
                                    <i class="bi bi-arrow-up-circle me-1"></i> Choose Plan
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
