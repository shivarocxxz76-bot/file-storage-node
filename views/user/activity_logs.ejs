<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
            <div>
                <h4 class="fw-bold mb-1">Security & Audit Logs</h4>
                <p class="text-muted small mb-0">Transparent audit trail of your authenticated sessions, cryptographic operations, and file events.</p>
            </div>
            <div class="d-flex gap-2">
                <input type="text" id="logSearchInput" class="form-control form-control-sm" placeholder="Search activities..." style="max-width: 220px;" onkeyup="filterLogs()">
            </div>
        </div>

        <div class="card card-custom p-4">
            <% if (!logs || logs.length === 0) { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-shield-check display-4 d-block mb-2 text-success"></i>
                    <h6 class="fw-semibold">No activity logs recorded</h6>
                    <p class="small text-muted">Your security events and audit records will appear here.</p>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="logsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Action</th>
                                <th>Description</th>
                                <th>Target Type</th>
                                <th>IP Address</th>
                                <th>User Agent / Device</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% logs.forEach(log => { 
                                let badgeClass = 'bg-primary-subtle text-primary';
                                if (log.action_type.includes('DELETE') || log.action_type.includes('PURGE')) badgeClass = 'bg-danger-subtle text-danger';
                                else if (log.action_type.includes('LOGIN') || log.action_type.includes('AUTH')) badgeClass = 'bg-success-subtle text-success';
                                else if (log.action_type.includes('SHARE')) badgeClass = 'bg-warning-subtle text-warning';
                                else if (log.action_type.includes('UPLOAD')) badgeClass = 'bg-info-subtle text-info';
                            %>
                                <tr>
                                    <td>
                                        <span class="badge <%= badgeClass %> font-monospace"><%= log.action_type %></span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark"><%= log.description %></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-body-secondary text-secondary text-uppercase"><%= log.target_type %></span>
                                    </td>
                                    <td class="small font-monospace text-muted"><%= log.ip_address || '127.0.0.1' %></td>
                                    <td class="small text-muted text-truncate" style="max-width: 200px;" title="<%= log.user_agent %>">
                                        <%= log.user_agent || 'Web Browser' %>
                                    </td>
                                    <td class="small text-muted">
                                        <div><%= new Date(log.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                                        <div style="font-size: 0.75rem;"><%= new Date(log.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %> (<%= timeAgo(log.createdAt) %>)</div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>
</div>

<script>
function filterLogs() {
    const input = document.getElementById('logSearchInput').value.toLowerCase();
    const rows = document.querySelectorAll('#logsTable tbody tr');
    rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(input) ? '' : 'none';
    });
}
</script>

<%- include('../partials/footer') %>
