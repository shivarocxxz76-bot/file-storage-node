<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1">Shared Files & Access Control</h4>
                <p class="text-muted small mb-0">Manage files shared with you and track secure links you've created.</p>
            </div>
            <a href="/files" class="btn btn-outline-primary">
                <i class="bi bi-share me-1"></i> Share a New File
            </a>
        </div>

        <ul class="nav nav-tabs mb-4" id="sharedTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold" id="with-me-tab" data-bs-toggle="tab" data-bs-target="#with-me" type="button" role="tab">
                    <i class="bi bi-box-arrow-in-down-right me-2 text-primary"></i>Shared With Me (<%= sharedWithMe.length %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold" id="by-me-tab" data-bs-toggle="tab" data-bs-target="#by-me" type="button" role="tab">
                    <i class="bi bi-box-arrow-up-right me-2 text-success"></i>Shared By Me (<%= sharedByMe.length %>)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="sharedTabContent">
            <!-- Tab 1: Shared with me -->
            <div class="tab-pane fade show active" id="with-me" role="tabpanel">
                <% if (!sharedWithMe || sharedWithMe.length === 0) { %>
                    <div class="card card-custom text-center py-5">
                        <i class="bi bi-inbox display-4 text-muted mb-2"></i>
                        <h5>No Shared Files</h5>
                        <p class="text-muted small">Files shared with your account by other users will appear here.</p>
                    </div>
                <% } else { %>
                    <div class="card card-custom p-0 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>File Name</th>
                                        <th>Shared By</th>
                                        <th>Size</th>
                                        <th>Permission</th>
                                        <th>Shared Date</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% sharedWithMe.forEach(item => { 
                                        const iconData = getFileIcon(item.file.file_extension);
                                    %>
                                        <tr class="searchable-item" data-search="<%= item.file.original_name %> <%= item.shared_by ? item.shared_by.full_name : '' %>">
                                            <td>
                                                <div class="d-flex align-items-center" role="button" onclick="previewFile('<%= item.file._id %>')">
                                                    <i class="bi <%= iconData.icon %> <%= iconData.color %> fs-4 me-2"></i>
                                                    <span class="fw-medium text-truncate" style="max-width: 250px;">
                                                        <%= item.file.original_name %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="small fw-semibold"><%= item.shared_by ? item.shared_by.full_name : 'Unknown' %></div>
                                                <div class="text-muted" style="font-size:0.75rem;"><%= item.shared_by ? item.shared_by.email : '' %></div>
                                            </td>
                                            <td class="small text-muted"><%= formatBytes(item.file.file_size) %></td>
                                            <td>
                                                <span class="badge bg-<%= item.permission === 'download' ? 'success' : (item.permission === 'edit' ? 'primary' : 'warning') %>-subtle text-<%= item.permission === 'download' ? 'success' : (item.permission === 'edit' ? 'primary' : 'warning') %> text-uppercase">
                                                    <%= item.permission %>
                                                </span>
                                            </td>
                                            <td class="small text-muted"><%= timeAgo(item.createdAt) %></td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-secondary" onclick="previewFile('<%= item.file._id %>')" title="Preview">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <% if (item.permission !== 'no-download') { %>
                                                        <a href="/files/download?file_id=<%= item.file._id %>" class="btn btn-outline-primary" title="Download Decrypted">
                                                            <i class="bi bi-download"></i>
                                                        </a>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Tab 2: Shared by me -->
            <div class="tab-pane fade" id="by-me" role="tabpanel">
                <% if (!sharedByMe || sharedByMe.length === 0) { %>
                    <div class="card card-custom text-center py-5">
                        <i class="bi bi-share display-4 text-muted mb-2"></i>
                        <h5>No Active Shares</h5>
                        <p class="text-muted small">You haven't shared any files yet. Share files directly from your My Files manager.</p>
                    </div>
                <% } else { %>
                    <div class="card card-custom p-0 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>File Name</th>
                                        <th>Shared Target</th>
                                        <th>Permission</th>
                                        <th>Expires</th>
                                        <th>Signed Link</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% sharedByMe.forEach(item => { 
                                        const iconData = getFileIcon(item.file.file_extension);
                                        const publicUrl = '/shared/' + item.share_token;
                                    %>
                                        <tr class="searchable-item" data-search="<%= item.file.original_name %>">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi <%= iconData.icon %> <%= iconData.color %> fs-4 me-2"></i>
                                                    <span class="fw-medium text-truncate" style="max-width: 200px;">
                                                        <%= item.file.original_name %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (item.shared_with) { %>
                                                    <div class="small fw-semibold"><%= item.shared_with.full_name %></div>
                                                    <div class="text-muted" style="font-size:0.75rem;"><%= item.shared_with.email %></div>
                                                <% } else { %>
                                                    <span class="badge bg-warning-subtle text-warning">Public Signed Link</span>
                                                    <%= item.access_password ? '🔒' : '' %>
                                                <% } %>
                                            </td>
                                            <td><span class="badge bg-secondary-subtle text-secondary text-uppercase"><%= item.permission %></span></td>
                                            <td class="small text-muted"><%= item.expires_at ? new Date(item.expires_at).toLocaleDateString() : 'Never' %></td>
                                            <td>
                                                <div class="input-group input-group-sm" style="max-width: 200px;">
                                                    <input type="text" class="form-control" value="<%= publicUrl %>" readonly id="link_<%= item._id %>">
                                                    <button class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText(window.location.origin + '<%= publicUrl %>'); showToast('Link copied to clipboard!', 'success');">
                                                        <i class="bi bi-clipboard"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <form method="POST" action="/shared/revoke" class="d-inline" onsubmit="return confirm('Revoke sharing access for this file?')">
                                                    <input type="hidden" name="share_id" value="<%= item._id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Revoke Share">
                                                        <i class="bi bi-x-circle me-1"></i> Revoke
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
