<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <!-- Page Title & Actions -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h4 class="fw-bold mb-1">Welcome, <%= user.full_name %> 👋</h4>
                <p class="text-muted small mb-0">Overview of your AES-256 encrypted cloud storage and recent security logs.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newFolderModal">
                    <i class="bi bi-folder-plus me-1"></i> New Folder
                </button>
                <a href="/files" class="btn btn-primary">
                    <i class="bi bi-cloud-upload me-1"></i> Upload Files
                </a>
            </div>
        </div>

        <!-- Storage Warning Banner -->
        <% if (isFull) { %>
            <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 mb-4 shadow-sm">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-octagon-fill fs-3 me-3 text-danger"></i>
                    <div>
                        <h6 class="alert-heading mb-1 fw-bold">Storage Limit Exceeded (100%)</h6>
                        <span class="small">You have consumed all <%= storageLimitFormatted %> of storage quota. Upgrade to resume uploading.</span>
                    </div>
                </div>
                <a href="/storage-plans" class="btn btn-danger btn-sm text-nowrap">Upgrade Now</a>
            </div>
        <% } else if (isNearLimit) { %>
            <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 shadow-sm">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-warning"></i>
                    <div>
                        <h6 class="alert-heading mb-1 fw-bold">Storage Almost Full (<%= storagePercentage %>%)</h6>
                        <span class="small">You have used <%= storageUsedFormatted %> out of <%= storageLimitFormatted %> available.</span>
                    </div>
                </div>
                <a href="/storage-plans" class="btn btn-warning btn-sm text-nowrap">Upgrade Plan</a>
            </div>
        <% } %>

        <!-- KPI Statistic Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Total Files</div>
                        <h3 class="fw-bold mb-0"><%= totalFiles %></h3>
                    </div>
                    <div class="stat-icon primary">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Storage Used</div>
                        <h3 class="fw-bold mb-0 text-truncate" style="font-size: 1.4rem;"><%= storageUsedFormatted %></h3>
                    </div>
                    <div class="stat-icon <%= isNearLimit ? 'warning' : (isFull ? 'danger' : 'success') %>">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Folders</div>
                        <h3 class="fw-bold mb-0"><%= totalFolders %></h3>
                    </div>
                    <div class="stat-icon info">
                        <i class="bi bi-folder2"></i>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Shared Items</div>
                        <h3 class="fw-bold mb-0"><%= totalShared %></h3>
                    </div>
                    <div class="stat-icon warning">
                        <i class="bi bi-share-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Quick Upload + Recent Files -->
            <div class="col-lg-8">
                <!-- Dropzone Box -->
                <div class="card card-custom p-4 mb-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-cloud-arrow-up text-primary me-2"></i>Quick Upload (AES-256 Auto Encrypted)</h6>
                    <div class="dropzone-box" id="fileDropzone">
                        <i class="bi bi-cloud-arrow-up dropzone-icon"></i>
                        <h6 class="fw-semibold mb-1">Drag and drop your files here</h6>
                        <p class="text-muted small mb-3">or click anywhere to browse from your computer</p>
                        <span class="badge bg-body-secondary text-muted border">Supports PDF, Office, Photos, Zip, Code, Media</span>
                        <input type="file" id="fileUploadInput" multiple class="d-none">
                    </div>

                    <div id="uploadProgressContainer" class="d-none mt-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span id="uploadStatusText">Encrypting & uploading files...</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <!-- Recent Files Table -->
                <div class="card card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Recent Files</h6>
                        <a href="/files" class="text-primary text-decoration-none small fw-semibold">View All Files &rarr;</a>
                    </div>

                    <% if (!recentFiles || recentFiles.length === 0) { %>
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No files uploaded yet. Drag files into the box above to store securely!
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Folder</th>
                                        <th>Size</th>
                                        <th>Uploaded</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentFiles.forEach(file => { 
                                        const iconData = getFileIcon(file.file_extension);
                                    %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi <%= iconData.icon %> <%= iconData.color %> fs-4 me-2"></i>
                                                    <span class="fw-medium text-truncate" style="max-width: 220px;" title="<%= file.original_name %>">
                                                        <%= file.original_name %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-body-secondary text-secondary">
                                                    <%= file.folder ? file.folder.folder_name : 'Root' %>
                                                </span>
                                            </td>
                                            <td class="small text-muted"><%= formatBytes(file.file_size) %></td>
                                            <td class="small text-muted"><%= timeAgo(file.createdAt) %></td>
                                            <td class="text-end">
                                                <div class="btn-group btn-group-sm">
                                                    <button type="button" class="btn btn-outline-secondary" onclick="previewFile('<%= file._id %>')" title="Preview">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <a href="/files/download?file_id=<%= file._id %>" class="btn btn-outline-secondary" title="Download">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-outline-secondary" data-file-id="<%= file._id %>" data-file-name="<%= file.original_name %>" onclick="openShareModal(this.dataset.fileId, this.dataset.fileName)" title="Share">
                                                        <i class="bi bi-share"></i>
                                                    </button>
                                                    <form method="POST" action="/files/delete" class="d-inline" onsubmit="return confirm('Move file to Recycle Bin?')">
                                                        <input type="hidden" name="file_id" value="<%= file._id %>">
                                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Storage Donut Chart + Security Activity Log -->
            <div class="col-lg-4">
                <div class="card card-custom p-4 mb-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart text-primary me-2"></i>Storage Breakdown</h6>
                    <div style="height: 220px; position: relative;">
                        <canvas id="userStorageChart"></canvas>
                    </div>
                    <div class="text-center mt-3 pt-3 border-top">
                        <div class="small text-muted mb-1">Current Plan: <strong class="text-primary"><%= user.storage_plan ? user.storage_plan.plan_name : 'Free Starter' %></strong></div>
                        <a href="/storage-plans" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-arrow-up-circle me-1"></i> Upgrade Storage Plan
                        </a>
                    </div>
                </div>

                <div class="card card-custom p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-shield-check text-success me-2"></i>Security Logs</h6>
                        <a href="/activity-logs" class="text-primary text-decoration-none small">View all</a>
                    </div>
                    <div class="list-group list-group-flush">
                        <% if (!recentActivities || recentActivities.length === 0) { %>
                            <div class="text-muted small py-3 text-center">No recent activities recorded.</div>
                        <% } else { %>
                            <% recentActivities.forEach(act => { %>
                                <div class="list-group-item px-0 py-2 border-0">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-primary-subtle text-primary" style="font-size: 0.7rem;"><%= act.action_type %></span>
                                        <small class="text-muted" style="font-size: 0.72rem;"><%= timeAgo(act.createdAt) %></small>
                                    </div>
                                    <div class="small text-truncate text-secondary mt-1"><%= act.description %></div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const storageChartData = {
        labels: <%- JSON.stringify(chartLabels) %>,
        values: <%- JSON.stringify(chartValues) %>
    };
    renderUserStorageChart('userStorageChart', storageChartData);
});
</script>

<%- include('../partials/footer') %>
