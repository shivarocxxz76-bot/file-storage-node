<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-1">Folders Organizer</h4>
                <p class="text-muted small mb-0">Organize your files into custom directories and color-coded tags.</p>
            </div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newFolderModal">
                <i class="bi bi-folder-plus me-1"></i> Create Folder
            </button>
        </div>

        <% if (!folders || folders.length === 0) { %>
            <div class="card card-custom text-center py-5">
                <i class="bi bi-folder-plus display-4 text-primary mb-2"></i>
                <h5>No Custom Folders Created</h5>
                <p class="text-muted small">Create folders to organize your work documents, personal photos, and media.</p>
                <div class="mt-2">
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newFolderModal">
                        <i class="bi bi-plus-lg me-1"></i> Create First Folder
                    </button>
                </div>
            </div>
        <% } else { %>
            <div class="row g-3">
                <% folders.forEach(f => { %>
                    <div class="col-12 col-md-6 col-lg-4 searchable-item" data-search="<%= f.folder_name %>">
                        <div class="card card-custom h-100 p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="stat-icon me-3" style="background: rgba(59, 130, 246, 0.1);">
                                        <i class="bi bi-folder-fill fs-3" style="color: <%= f.color_code || '#3b82f6' %>"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-truncate" style="max-width: 170px;">
                                            <a href="/files?folder_id=<%= f._id %>" class="text-decoration-none text-reset">
                                                <%= f.folder_name %>
                                            </a>
                                        </h6>
                                        <small class="text-muted">
                                            <%= f.parent ? ('Inside ' + f.parent.folder_name) : 'Root Directory' %>
                                        </small>
                                    </div>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li><a class="dropdown-item" href="/files?folder_id=<%= f._id %>"><i class="bi bi-folder2-open me-2 text-primary"></i> Open Folder</a></li>
                                        <li>
                                            <form method="POST" action="/folders/delete" onsubmit="return confirm('Move folder and all files inside to Recycle Bin?')">
                                                <input type="hidden" name="folder_id" value="<%= f._id %>">
                                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash3 me-2"></i> Delete Folder</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top text-muted small">
                                <span><i class="bi bi-files me-1"></i> <%= f.file_count %> files</span>
                                <span><i class="bi bi-hdd me-1"></i> <%= formatBytes(f.folder_size) %></span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>
</div>

<%- include('../partials/footer') %>
