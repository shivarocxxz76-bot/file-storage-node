<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | <%= appName %></title>
    <!-- Mobile & PWA Optimization Meta Tags -->
    <meta name="theme-color" content="#06b6d4">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="SecureVault">
    <meta name="application-name" content="SecureVault">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dark-mode.css">
    <style>
        body.auth-page,
        .split-auth-layout {
            background: radial-gradient(circle at 35% 50%, rgba(6, 10, 22, 0.08) 0%, rgba(6, 10, 22, 0.45) 60%, rgba(4, 7, 16, 0.78) 100%),
                        url('/images/cyber-lock.jpg') no-repeat center center fixed !important;
            background-size: cover !important;
            background-position: center center !important;
            background-attachment: fixed !important;
            min-height: 100vh;
        }
        .split-auth-hero {
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }
        .split-auth-form-side {
            background: rgba(6, 10, 22, 0.20) !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }
        .split-auth-form-container {
            background: rgba(10, 16, 32, 0.75) !important;
            backdrop-filter: blur(18px) !important;
            -webkit-backdrop-filter: blur(18px) !important;
            border: 1px solid rgba(6, 182, 212, 0.30) !important;
            box-shadow: 0 16px 45px rgba(0, 0, 0, 0.7), 0 0 35px rgba(6, 182, 212, 0.15) !important;
        }
    </style>
</head>
<body class="auth-page">

<div class="split-auth-layout">
    <!-- Left Hero Brand Column -->
    <div class="split-auth-hero">
        <!-- Top Logo -->
        <div class="d-flex align-items-center gap-3">
            <div class="split-auth-brand-logo">
                <i class="bi bi-shield-lock-fill text-white fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0 text-white"><%= appName %></h5>
                <span class="text-white-50 small text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.12em;">SECURE CLOUD PLATFORM</span>
            </div>
        </div>

        <!-- Bottom Narrative -->
        <div class="split-auth-hero-content">
            <div class="mb-3">
                <span class="split-auth-pill">
                    <span class="text-teal me-2" style="font-size: 0.9rem;">●</span> Your files. Your control.
                </span>
            </div>

            <h1 class="display-5 fw-bold text-white mb-3" style="letter-spacing: -0.02em;">
                Create your <br>
                <span class="text-teal">secure space.</span>
            </h1>

            <p class="text-white-50 fs-6 mb-4" style="max-width: 520px; line-height: 1.6;">
                Create your account and get a secure digital space to upload, organize and manage your important files with confidence.
            </p>

            <div class="d-flex flex-wrap">
                <span class="split-auth-feature-badge">
                    <i class="bi bi-shield-check text-teal me-2"></i> Secure Access
                </span>
                <span class="split-auth-feature-badge">
                    <i class="bi bi-cloud-check text-teal me-2"></i> Easy Storage
                </span>
                <span class="split-auth-feature-badge">
                    <i class="bi bi-folder-check text-teal me-2"></i> File Management
                </span>
                <span class="split-auth-feature-badge">
                    <i class="bi bi-activity text-teal me-2"></i> Activity Tracking
                </span>
            </div>
        </div>
    </div>

    <!-- Right Form Column -->
    <div class="split-auth-form-side">
        <div class="split-auth-form-container">
            <div class="mb-4">
                <h2 class="fw-bold text-white mb-1">Create account</h2>
                <p class="text-white-50 small mb-0">Join <%= appName %> today.</p>
            </div>

            <%- include('../partials/flash') %>

            <form method="POST" action="/auth/register">
                <div class="mb-3">
                    <label for="full_name" class="form-label">Full name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" class="form-control" name="full_name" id="full_name" required placeholder="Enter your full name" autofocus>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control" name="email" id="email" required placeholder="you@example.com">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Create password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" class="form-control" name="password" id="password" required placeholder="Create a secure password" oninput="checkPasswordStrength(this.value)">
                        <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePasswordVisibility('password')" style="border-radius: 0 12px 12px 0;">
                            <i class="bi bi-eye" id="password-toggle-icon"></i>
                        </button>
                    </div>

                    <!-- Password strength visualizer -->
                    <div class="d-flex gap-1 mt-2 mb-1" id="strengthMeter">
                        <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded-pill" style="height: 3px;" id="bar1"></div>
                        <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded-pill" style="height: 3px;" id="bar2"></div>
                        <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded-pill" style="height: 3px;" id="bar3"></div>
                        <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded-pill" style="height: 3px;" id="bar4"></div>
                    </div>
                    <small class="text-white-50" style="font-size: 0.72rem;">Use at least 6 characters for better security.</small>
                </div>

                <input type="hidden" name="confirm_password" id="confirm_password_hidden">

                <button type="submit" class="btn btn-teal-gradient w-100 mt-3" onclick="syncPassword()">
                    Create my account &rarr;
                </button>
            </form>

            <div class="d-flex align-items-center my-4">
                <hr class="flex-grow-1 border-secondary border-opacity-50 my-0">
                <span class="px-3 text-white-50" style="font-size: 0.68rem; letter-spacing: 0.15em;">ACCOUNT</span>
                <hr class="flex-grow-1 border-secondary border-opacity-50 my-0">
            </div>

            <p class="text-center text-white-50 small mb-4">
                Already have an account? 
                <a href="/auth/login" class="text-teal fw-semibold text-decoration-none ms-1">Sign In</a>
            </p>

            <div class="text-center text-white-50" style="font-size: 0.75rem;">
                <i class="bi bi-shield-check text-teal me-1"></i> Protected connection &bull; <%= appName %>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function syncPassword() {
    const p = document.getElementById('password').value;
    document.getElementById('confirm_password_hidden').value = p;
}

function togglePasswordVisibility(fieldId) {
    const field = document.getElementById(fieldId);
    const icon = document.getElementById('password-toggle-icon');
    if (field.type === 'password') {
        field.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        field.type = 'password';
        icon.className = 'bi bi-eye';
    }
}

function checkPasswordStrength(val) {
    const b1 = document.getElementById('bar1');
    const b2 = document.getElementById('bar2');
    const b3 = document.getElementById('bar3');
    const b4 = document.getElementById('bar4');
    
    // reset
    [b1, b2, b3, b4].forEach(b => {
        b.className = 'flex-grow-1 bg-secondary bg-opacity-25 rounded-pill';
    });

    if (val.length >= 2) b1.className = 'flex-grow-1 bg-danger rounded-pill';
    if (val.length >= 6) b2.className = 'flex-grow-1 bg-warning rounded-pill';
    if (val.length >= 8 && /[A-Z]/.test(val)) b3.className = 'flex-grow-1 bg-info rounded-pill';
    if (val.length >= 10 && /[0-9!@#$%^&*]/.test(val)) b4.className = 'flex-grow-1 bg-success rounded-pill';
}
</script>
<script src="/js/pwa.js"></script>
</body>
</html>
