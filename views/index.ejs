<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'SecureVault - Cloud Storage' %> | <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dark-mode.css">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg border-bottom sticky-top py-3" style="background: rgba(10, 16, 30, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold fs-4 text-primary" href="/">
                <i class="bi bi-shield-lock-fill me-2 fs-3"></i> <%= appName %>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-2">
                    <li class="nav-item"><a class="nav-link fw-medium" href="#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link fw-medium" href="#security">Security</a></li>
                    <li class="nav-item"><a class="nav-link fw-medium" href="#pricing">Pricing Plans</a></li>
                    <li class="nav-item"><a class="nav-link fw-medium" href="#about">About Project</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-icon btn-light rounded-circle me-2" id="themeToggleBtn" type="button" title="Toggle Theme" style="width: 38px; height: 38px;">
                        <i class="bi bi-moon-stars-fill text-secondary"></i>
                    </button>
                    <% if (user) { %>
                        <a href="/dashboard" class="btn btn-outline-primary btn-sm px-3">
                            <i class="bi bi-grid-fill me-1"></i> Dashboard
                        </a>
                        <a href="/auth/logout" class="btn btn-danger btn-sm px-3">Logout</a>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-outline-primary btn-sm px-3">Sign In</a>
                        <a href="/auth/register" class="btn btn-primary btn-sm px-3 shadow-sm">Get Free Storage</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="py-5 py-lg-6 position-relative overflow-hidden">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 text-center text-lg-start">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mb-3">
                        <i class="bi bi-shield-check me-1"></i> Final-Year B.Sc. IT Project &bull; 2026
                    </span>
                    <h1 class="display-4 fw-bold mb-3 tracking-tight">
                        Web-Based Secure File Storage & Access Management
                    </h1>
                    <p class="lead text-muted mb-4">
                        Enterprise-grade cloud storage featuring AES-256 encryption at rest, Role-Based Access Control, SHA-256 cryptographic verification, signed sharing links, and multi-tier storage quotas.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start mb-4">
                        <% if (user) { %>
                            <a href="/dashboard" class="btn btn-primary btn-lg px-4 shadow">
                                <i class="bi bi-folder2-open me-2"></i> Go to My Workspace
                            </a>
                        <% } else { %>
                            <a href="/auth/register" class="btn btn-primary btn-lg px-4 shadow">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> Get Started Free (500MB)
                            </a>
                            <a href="/auth/login" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                            </a>
                        <% } %>
                    </div>
                    <div class="d-flex align-items-center justify-content-center justify-content-lg-start gap-4 text-muted small">
                        <span><i class="bi bi-shield-lock-fill text-primary me-1"></i> AES-256 Encrypted</span>
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i> RBAC Security</span>
                        <span><i class="bi bi-eye-fill text-info me-1"></i> Instant Preview</span>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card card-custom shadow-lg border p-3 p-md-4">
                        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-danger rounded-circle p-1"></span>
                                <span class="badge bg-warning rounded-circle p-1"></span>
                                <span class="badge bg-success rounded-circle p-1"></span>
                                <span class="small fw-semibold ms-2 text-muted">Cloud Workspace Preview</span>
                            </div>
                            <span class="badge bg-primary-subtle text-primary">Node.js + MongoDB</span>
                        </div>
                        <div class="bg-body-tertiary rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold">Cloud Quota (500MB Free Starter)</span>
                                <span class="badge bg-success small">62% Available</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-primary" style="width: 38%"></div>
                            </div>
                        </div>
                        <div class="list-group list-group-flush small">
                            <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-5 me-2"></i>
                                    <div>
                                        <div class="fw-semibold">Final_Project_Report.pdf</div>
                                        <div class="text-muted" style="font-size:0.72rem;">2.4 MB &bull; AES-256 Encrypted</div>
                                    </div>
                                </div>
                                <span class="badge bg-success-subtle text-success">Shared (View Only)</span>
                            </div>
                            <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-zip-fill text-warning fs-5 me-2"></i>
                                    <div>
                                        <div class="fw-semibold">Database_Backups_2026.zip</div>
                                        <div class="text-muted" style="font-size:0.72rem;">18.5 MB &bull; SHA-256 Verified</div>
                                    </div>
                                </div>
                                <span class="badge bg-primary-subtle text-primary">Private</span>
                            </div>
                            <div class="list-group-item d-flex align-items-center justify-content-between px-0">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-code-fill text-purple fs-5 me-2"></i>
                                    <div>
                                        <div class="fw-semibold">server_bootstrap.js</div>
                                        <div class="text-muted" style="font-size:0.72rem;">12.1 KB &bull; Syntax Highlighted</div>
                                    </div>
                                </div>
                                <span class="badge bg-info-subtle text-info">Signed Link</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="py-5 bg-body-tertiary" id="features">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="text-primary fw-semibold small text-uppercase tracking-wider">Engineered for Academic & Industry Excellence</span>
                <h2 class="fw-bold mt-1">Core System Capabilities</h2>
                <p class="text-muted">A full-featured cloud file management ecosystem built strictly from scratch.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4">
                        <div class="stat-icon primary mb-3">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h5 class="fw-bold">AES-256 Encryption at Rest</h5>
                        <p class="text-muted small mb-0">Files are encrypted with AES-256-CBC before writing to disk and decrypted on-the-fly during streaming.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4">
                        <div class="stat-icon success mb-3">
                            <i class="bi bi-cloud-arrow-up"></i>
                        </div>
                        <h5 class="fw-bold">Multer File Engine</h5>
                        <p class="text-muted small mb-0">Drag-and-drop asynchronous multi-file upload with MIME validation, dynamic progress meters, and real-time quota calculations.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4">
                        <div class="stat-icon warning mb-3">
                            <i class="bi bi-share-fill"></i>
                        </div>
                        <h5 class="fw-bold">Granular Access Sharing</h5>
                        <p class="text-muted small mb-0">Share directly with registered users or generate temporary signed tokens protected with custom passcodes and expiration dates.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4">
                        <div class="stat-icon info mb-3">
                            <i class="bi bi-eye-fill"></i>
                        </div>
                        <h5 class="fw-bold">In-Browser File Previews</h5>
                        <p class="text-muted small mb-0">Native previews for PDFs, audio, video, photos, and formatted syntax highlighting for 12+ programming languages.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4">
                        <div class="stat-icon danger mb-3">
                            <i class="bi bi-trash3-fill"></i>
                        </div>
                        <h5 class="fw-bold">Two-Stage Recycle Bin</h5>
                        <p class="text-muted small mb-0">Soft-delete protection allowing full file and folder restoration, with permanent purge actions that refund user storage quotas.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4">
                        <div class="stat-icon text-purple mb-3" style="background: rgba(139, 92, 246, 0.1);">
                            <i class="bi bi-credit-card-2-front"></i>
                        </div>
                        <h5 class="fw-bold">Demo Billing & Upgrades</h5>
                        <p class="text-muted small mb-0">Full simulation of checkout workflows with automated quota upgrades, transaction IDs, invoice generation, and tier management.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing / Storage Plans Section -->
    <section class="py-5" id="pricing">
        <div class="container py-4">
            <div class="text-center mb-5">
                <span class="text-primary fw-semibold small text-uppercase tracking-wider">Flexible Quotas</span>
                <h2 class="fw-bold mt-1">Storage Upgrade Plans</h2>
                <p class="text-muted">Choose the cloud capacity that fits your research and project storage needs.</p>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4 border">
                        <div class="mb-3">
                            <h5 class="fw-bold mb-1">Free Starter</h5>
                            <span class="badge bg-secondary-subtle text-secondary">Default Academic Tier</span>
                        </div>
                        <div class="d-flex align-items-baseline mb-3">
                            <h2 class="fw-bold mb-0">$0</h2>
                            <span class="text-muted small ms-2">/ month</span>
                        </div>
                        <p class="text-muted small">Ideal for testing, development, and standard assignment documents.</p>
                        <ul class="list-unstyled small mb-4">
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> <strong>500 MB</strong> Cloud Storage</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> 25 MB Max File Size</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> Unlimited Folder Organization</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> Basic File Sharing</li>
                        </ul>
                        <a href="/auth/register" class="btn btn-outline-primary w-100 mt-auto">Get Started Free</a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4 border-primary position-relative shadow">
                        <span class="position-absolute top-0 start-50 translate-middle badge bg-primary px-3 py-1 rounded-pill">
                            Most Popular
                        </span>
                        <div class="mb-3">
                            <h5 class="fw-bold mb-1">Pro Storage</h5>
                            <span class="badge bg-primary-subtle text-primary">Power Users</span>
                        </div>
                        <div class="d-flex align-items-baseline mb-3">
                            <h2 class="fw-bold mb-0 text-primary">$9.99</h2>
                            <span class="text-muted small ms-2">/ month</span>
                        </div>
                        <p class="text-muted small">Designed for multimedia projects, raw datasets, and archives.</p>
                        <ul class="list-unstyled small mb-4">
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> <strong>5 GB</strong> Ultra Cloud Storage</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> 200 MB Max File Size</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> Password-Protected Share Links</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> Detailed Audit & Security Logs</li>
                        </ul>
                        <a href="/storage-plans" class="btn btn-primary w-100 mt-auto">Upgrade to Pro</a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4 border">
                        <div class="mb-3">
                            <h5 class="fw-bold mb-1">Business Tier</h5>
                            <span class="badge bg-dark-subtle text-light">Enterprise Team</span>
                        </div>
                        <div class="d-flex align-items-baseline mb-3">
                            <h2 class="fw-bold mb-0">$24.99</h2>
                            <span class="text-muted small ms-2">/ month</span>
                        </div>
                        <p class="text-muted small">Maximum storage capacity with priority ticket response.</p>
                        <ul class="list-unstyled small mb-4">
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> <strong>20 GB</strong> High-Speed Storage</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> 1 GB Max File Size</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> Priority Support Desk</li>
                            <li class="mb-2"><i class="bi bi-check-lg text-success me-2"></i> Full System Audit Logs</li>
                        </ul>
                        <a href="/storage-plans" class="btn btn-outline-primary w-100 mt-auto">Choose Business</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-5 bg-body border-top" id="about">
        <div class="container">
            <div class="row g-4 justify-content-between">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold fs-5">
                        <i class="bi bi-shield-lock-fill"></i> <%= appName %>
                    </div>
                    <p class="text-muted small mb-3" style="max-width: 450px;">
                        Web-Based Secure File Storage and Access Management System. Developed as a comprehensive B.Sc. IT final-year project using Node.js, Express.js, MongoDB (Mongoose), and Bootstrap 5.
                    </p>
                    <div class="text-muted small">
                        &copy; 2026 <%= appName %>. All academic project rights reserved.
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="row">
                        <div class="col-6">
                            <h6 class="fw-bold mb-3 small text-uppercase">Modules</h6>
                            <ul class="list-unstyled small text-muted">
                                <li class="mb-2"><a href="/auth/login" class="text-decoration-none text-muted">Sign In</a></li>
                                <li class="mb-2"><a href="/auth/register" class="text-decoration-none text-muted">Registration</a></li>
                                <li class="mb-2"><a href="/storage-plans" class="text-decoration-none text-muted">Storage Plans</a></li>
                                <li class="mb-2"><a href="/support" class="text-decoration-none text-muted">Helpdesk</a></li>
                            </ul>
                        </div>
                        <div class="col-6">
                            <h6 class="fw-bold mb-3 small text-uppercase">Tech Stack</h6>
                            <ul class="list-unstyled small text-muted">
                                <li class="mb-1">&bull; Node.js & Express</li>
                                <li class="mb-1">&bull; MongoDB & Mongoose</li>
                                <li class="mb-1">&bull; EJS & Bootstrap 5</li>
                                <li class="mb-1">&bull; AES-256 Encryption</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
