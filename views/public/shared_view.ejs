<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | <%= appName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dark-mode.css">
</head>
<body class="bg-body-tertiary d-flex flex-column min-vh-100">

    <!-- Topbar -->
    <header class="bg-body border-bottom py-3">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/" class="d-flex align-items-center text-primary text-decoration-none fw-bold fs-4">
                <i class="bi bi-shield-lock-fill me-2 fs-3"></i> <%= appName %>
            </a>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-icon btn-light rounded-circle" id="themeToggleBtn" type="button" title="Toggle Theme" style="width: 38px; height: 38px;">
                    <i class="bi bi-moon-stars-fill text-secondary"></i>
                </button>
                <a href="/auth/login" class="btn btn-sm btn-outline-primary">Sign In</a>
            </div>
        </div>
    </header>

    <main class="container my-auto py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">

                <% if (error) { %>
                    <!-- Error State -->
                    <div class="card card-custom p-4 p-md-5 text-center shadow-lg border-danger-subtle">
                        <i class="bi bi-exclamation-octagon-fill text-danger display-3 mb-3"></i>
                        <h4 class="fw-bold"><%= title %></h4>
                        <p class="text-muted"><%= error %></p>
                        <div class="mt-3">
                            <a href="/" class="btn btn-primary"><i class="bi bi-house me-1"></i> Go to Homepage</a>
                        </div>
                    </div>
                <% } else if (requiresPassword && !authorized) { %>
                    <!-- Passcode Protected State -->
                    <div class="card card-custom p-4 p-md-5 shadow-lg">
                        <div class="text-center mb-4">
                            <i class="bi bi-shield-lock-fill text-warning display-4 mb-2"></i>
                            <h4 class="fw-bold">Password Protected Link</h4>
                            <p class="text-muted small">This file is restricted with an access passcode. Enter it below to unlock.</p>
                        </div>

                        <% if (passwordError) { %>
                            <div class="alert alert-danger py-2 small mb-3"><%= passwordError %></div>
                        <% } %>

                        <form method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Passcode</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-secondary"><i class="bi bi-key"></i></span>
                                    <input type="password" class="form-control" name="passcode" required placeholder="Enter passcode" autofocus>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                <i class="bi bi-unlock-fill me-1"></i> Unlock File Access
                            </button>
                        </form>
                    </div>
                <% } else if (share && share.file) { 
                    const file = share.file;
                    const iconData = getFileIcon(file.file_extension);
                %>
                    <!-- Authorized Share Card -->
                    <div class="card card-custom p-4 p-md-5 text-center shadow-lg">
                        <div class="mb-3">
                            <i class="bi <%= iconData.icon %> <%= iconData.color %> display-1"></i>
                        </div>

                        <h4 class="fw-bold mb-1 text-break"><%= file.original_name %></h4>
                        <div class="text-muted small mb-4">
                            <span><%= formatBytes(file.file_size) %></span> &bull; 
                            <span>Shared by <strong><%= share.shared_by ? share.shared_by.full_name : 'A SecureVault User' %></strong></span>
                        </div>

                        <div class="p-3 bg-body-tertiary rounded-3 mb-4 text-start small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Security</span>
                                <span class="badge bg-primary-subtle text-primary">AES-256 Encrypted</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Access Level</span>
                                <span class="badge bg-success-subtle text-success text-uppercase"><%= share.permission || 'DOWNLOAD' %></span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Link Expiration</span>
                                <span class="fw-semibold"><%= share.expires_at ? new Date(share.expires_at).toLocaleDateString() : 'Never' %></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <% if (share.permission === 'download' || share.permission === 'edit') { %>
                                <a href="/files/download?token=<%= share.share_token %>" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                                    <i class="bi bi-download me-2"></i> Download Decrypted File
                                </a>
                            <% } else { %>
                                <div class="alert alert-info small mb-0">
                                    <i class="bi bi-info-circle me-1"></i> This file is shared in View Only mode (no download allowed).
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <footer class="bg-body border-top py-3 text-center text-muted small mt-auto">
        &copy; 2026 <%= appName %>. Web-Based Secure File Storage and Access Management System.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
