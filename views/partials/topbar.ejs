<header class="topbar d-flex align-items-center justify-content-between px-3 px-lg-4">
    <div class="d-flex align-items-center gap-3">
        <!-- Mobile Sidebar Toggle -->
        <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggleBtn" type="button" aria-label="Toggle Sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>

        <!-- Global Search Box -->
        <% if (user && user.role === 'admin') { %>
            <form action="/admin/search" method="GET" class="d-none d-md-flex" style="max-width: 380px;">
                <div class="input-group">
                    <span class="input-group-text bg-body-secondary border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="q" id="liveSearchInput" class="form-control bg-body-secondary border-start-0 ps-0" placeholder="Global search users, files, payments..." value="<%= typeof query !== 'undefined' ? query : '' %>">
                </div>
            </form>
        <% } else { %>
            <div class="input-group d-none d-md-flex" style="max-width: 380px;">
                <span class="input-group-text bg-body-secondary border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="liveSearchInput" class="form-control bg-body-secondary border-start-0 ps-0" placeholder="Search files, folders or tickets...">
            </div>
        <% } %>
    </div>

    <div class="d-flex align-items-center gap-2 gap-md-3">
        <!-- Install App Button -->
        <button class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 pwa-install-btn d-none align-items-center gap-1" type="button" onclick="triggerPwaInstall()" title="Install SecureVault App">
            <i class="bi bi-phone"></i>
            <span class="d-none d-sm-inline">Install App</span>
        </button>


        <!-- Notifications Dropdown -->
        <div class="dropdown">
            <button class="btn btn-sm btn-light rounded-circle position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 38px; height: 38px;">
                <i class="bi bi-bell-fill text-secondary"></i>
                <% if (unreadNotifsCount > 0) { %>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                        <%= unreadNotifsCount > 9 ? '9+' : unreadNotifsCount %>
                    </span>
                <% } %>
            </button>

            <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0" style="width: 320px; max-width: 90vw;">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">Notifications</h6>
                    <a href="/notifications" class="text-primary text-decoration-none small">View all</a>
                </div>
                <div class="list-group list-group-flush" style="max-height: 280px; overflow-y: auto;">
                    <% if (!recentNotifs || recentNotifs.length === 0) { %>
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-bell-slash fs-4 d-block mb-1"></i>
                            No notifications yet
                        </div>
                    <% } else { %>
                        <% recentNotifs.forEach(notif => { %>
                            <a href="/notifications" class="list-group-item list-group-item-action p-3 <%= notif.is_read ? '' : 'bg-body-tertiary fw-medium' %>">
                                <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                    <span class="badge bg-<%= notif.type %>-subtle text-<%= notif.type %> border border-<%= notif.type %>-subtle">
                                        <%= notif.title %>
                                    </span>
                                </div>
                                <p class="mb-0 text-muted small text-truncate"><%= notif.message %></p>
                            </a>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- User Profile Dropdown -->
        <% if (user) { %>
            <div class="dropdown">
                <button class="btn btn-sm d-flex align-items-center gap-2 p-1 rounded-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                        <%= (user.full_name || 'U').charAt(0).toUpperCase() %>
                    </div>
                    <div class="d-none d-lg-block text-start me-1">
                        <div class="fw-semibold small leading-tight"><%= user.full_name %></div>
                        <div class="text-muted" style="font-size: 0.72rem;"><%= user.role === 'admin' ? 'Administrator' : 'User' %></div>
                    </div>
                    <i class="bi bi-chevron-down text-muted small d-none d-lg-block"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2">
                    <li class="px-3 py-2 border-bottom d-lg-none">
                        <div class="fw-bold"><%= user.full_name %></div>
                        <div class="text-muted small"><%= user.email %></div>
                    </li>
                    <% if (typeof currentUrl !== 'undefined' && currentUrl && currentUrl.startsWith('/admin')) { %>
                        <!-- In Admin Panel: "My Profile" removed -->
                        <li><a class="dropdown-item py-2 text-primary" href="/dashboard"><i class="bi bi-person-workspace me-2"></i> User Portal</a></li>
                        <li><a class="dropdown-item py-2" href="/admin/settings"><i class="bi bi-sliders me-2 text-secondary"></i> System Settings</a></li>
                        <li><a class="dropdown-item py-2" href="/admin/logs"><i class="bi bi-shield-lock me-2 text-info"></i> Audit Logs</a></li>
                    <% } else { %>
                        <li><a class="dropdown-item py-2" href="/profile"><i class="bi bi-person me-2 text-primary"></i> My Profile</a></li>
                        <li><a class="dropdown-item py-2" href="/activity-logs"><i class="bi bi-shield-check me-2 text-success"></i> Security Logs</a></li>
                        <li><a class="dropdown-item py-2" href="/storage-plans"><i class="bi bi-hdd-network me-2 text-warning"></i> Upgrade Storage</a></li>
                        <% if (user.role === 'admin') { %>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2 text-purple fw-semibold" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i> Admin Panel</a></li>
                        <% } %>
                    <% } %>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-info pwa-install-btn d-none" href="javascript:void(0)" onclick="triggerPwaInstall()"><i class="bi bi-phone me-2"></i> Install App</a></li>
                    <li><a class="dropdown-item py-2 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                </ul>
            </div>
        <% } %>
    </div>
</header>

<%- include('./flash') %>
