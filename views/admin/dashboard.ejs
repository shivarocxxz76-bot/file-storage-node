<%- include('../partials/header') %>
<%- include('../partials/admin_sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <!-- Header & Quick Actions -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h4 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-primary me-2"></i>Administrative Control Center </h4>
                <p class="text-muted small mb-0">Enterprise platform monitoring, AES-256 crypto health, regular user activity analytics, and billing ledger.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/admin/search" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-search me-1"></i> Global Search
                </a>
                <a href="/admin/users" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-people me-1"></i> Manage Users
                </a>
                <a href="/admin/files" class="btn btn-primary btn-sm">
                    <i class="bi bi-shield-shaded me-1"></i> File Moderation
                </a>
            </div>
        </div>

        <!-- Live System Health & Crypto Telemetry Bar -->
        <div class="card card-custom p-3 mb-4 bg-body-secondary">
            <div class="row g-3 align-items-center">
                <div class="col-6 col-md-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spanner-pulse bg-success rounded-circle" style="width: 10px; height: 10px; display: inline-block;"></span>
                        <span class="small fw-bold text-success">AES-256-CBC Engine</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem;">Hardware Encryption Online</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spanner-pulse bg-info rounded-circle" style="width: 10px; height: 10px; display: inline-block;"></span>
                        <span class="small fw-bold text-info">Database Cluster</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem;">MongoDB Kidvalue Synced</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spanner-pulse bg-warning rounded-circle" style="width: 10px; height: 10px; display: inline-block;"></span>
                        <span class="small fw-bold text-warning">RBAC Access Guard</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem;">Strict User/Admin Separation</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="spanner-pulse bg-primary rounded-circle" style="width: 10px; height: 10px; display: inline-block;"></span>
                        <span class="small fw-bold text-primary">Threat Defense</span>
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem;">Stealth Security Shield Active</div>
                </div>
            </div>
        </div>


        <!-- KPI Statistic Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Registered Users</div>
                        <h3 class="fw-bold mb-1"><%= totalUsers %></h3>
                        <span class="badge bg-primary-subtle text-primary" style="font-size: 0.6rem;">Active Accounts</span>
                    </div>
                    <div class="stat-icon primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Encrypted Vault</div>
                        <h3 class="fw-bold mb-1"><%= totalFiles %></h3>
                        <span class="badge bg-info-subtle text-info" style="font-size: 0.6rem;">AES-256 Protected</span>
                    </div>
                    <div class="stat-icon info">
                        <i class="bi bi-file-earmark-lock2-fill"></i>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Storage Pool Used</div>
                        <h3 class="fw-bold mb-1 text-truncate" style="font-size: 1.35rem;"><%= totalStorageFormatted %></h3>
                        <span class="badge bg-warning-subtle text-warning" style="font-size: 0.6rem;">Capacity Meter</span>
                    </div>
                    <div class="stat-icon warning">
                        <i class="bi bi-hdd-network-fill"></i>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-custom stat-card">
                    <div>
                        <div class="text-muted small fw-medium mb-1">Platform Revenue</div>
                        <h3 class="fw-bold mb-1 text-success">$<%= totalRevenue %></h3>
                        <span class="badge bg-success-subtle text-success" style="font-size: 0.6rem;">Billing Ledger</span>
                    </div>
                    <div class="stat-icon success">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold mb-0"><i class="bi bi-bar-chart text-primary me-2"></i>File Upload Activity</h6>
                            <span class="small text-muted">Monthly user encrypted upload volumes</span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary">2026 Trend</span>
                    </div>
                    <div style="height: 250px; position: relative;">
                        <canvas id="adminUploadsChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>Revenue Growth ($)</h6>
                            <span class="small text-muted">Cumulative storage subscription inflow</span>
                        </div>
                        <span class="badge bg-success-subtle text-success">Billing Curve</span>
                    </div>
                    <div style="height: 250px; position: relative;">
                        <canvas id="adminRevenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Users & Transactions Tables -->
        <div class="row g-4">
            <!-- Recent Users -->
            <div class="col-lg-6">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-person-plus text-primary me-2"></i>Recently Registered Users</h6>
                        <a href="/admin/users" class="small text-primary text-decoration-none fw-semibold">All Users &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Plan</th>
                                    <th>Status</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentUsers.forEach(u => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                    <%= (u.full_name || 'U').charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold small"><%= u.full_name %></div>
                                                    <div class="text-muted" style="font-size: 0.72rem;"><%= u.email %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary"><%= u.storage_plan ? u.storage_plan.plan_name : 'Free Starter' %></span>
                                        </td>
                                        <td>
                                            <span class="badge bg-<%= u.status === 'active' ? 'success' : 'danger' %>-subtle text-<%= u.status === 'active' ? 'success' : 'danger' %> text-capitalize">
                                                <%= u.status %>
                                            </span>
                                        </td>
                                        <td class="small text-muted"><%= timeAgo(u.createdAt) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Recent Payments -->
            <div class="col-lg-6">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-cash-stack text-success me-2"></i>Latest Transactions</h6>
                        <a href="/admin/payments" class="small text-primary text-decoration-none fw-semibold">Billing Ledger &rarr;</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Plan</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (!recentPayments || recentPayments.length === 0) { %>
                                    <tr><td colspan="4" class="text-center text-muted py-3">No payments recorded yet.</td></tr>
                                <% } else { %>
                                    <% recentPayments.forEach(p => { %>
                                        <tr>
                                            <td>
                                                <div class="fw-semibold small"><%= p.user ? p.user.full_name : 'Deleted User' %></div>
                                                <div class="small font-monospace text-muted" style="font-size: 0.75rem;"><%= p.transaction_id %></div>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary"><%= p.plan ? p.plan.plan_name : 'Upgrade' %></span>
                                            </td>
                                            <td class="fw-bold text-success">$<%= p.amount.toFixed(2) %></td>
                                            <td class="small text-muted"><%= timeAgo(p.payment_date) %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const uploadData = <%- JSON.stringify(monthlyUploadsData) %>;
    const revenueData = <%- JSON.stringify(revenueData) %>;

    renderAdminUploadsChart('adminUploadsChart', uploadData);
    renderAdminRevenueChart('adminRevenueChart', revenueData);
});
</script>

<%- include('../partials/footer') %>