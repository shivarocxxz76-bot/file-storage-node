<%- include('../partials/header') %>
<%- include('../partials/admin_sidebar') %>


<style>
/* =====================================================
   FILE & STORAGE ANALYTICS STYLES (MATCHING PHP FORM)
===================================================== */

/* PAGE HEADER */
.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 22px;
    margin-bottom: 20px;
    border-radius: 17px;
    background: rgba(255,255,255,0.035);
    border: 1px solid rgba(255,255,255,0.07);
}

.page-header-title {
    display: flex;
    align-items: center;
    gap: 12px;
}

.page-header-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(45,212,191,0.10);
    color: #5eead4;
    font-size: 19px;
}

.page-header h2 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
}

.page-header p {
    margin: 4px 0 0;
    color: rgba(255,255,255,0.35);
    font-size: 11px;
}

/* STAT CARDS */
.stat-card {
    position: relative;
    padding: 21px;
    min-height: 145px;
    border-radius: 17px;
    background: rgba(255,255,255,0.035);
    border: 1px solid rgba(255,255,255,0.07);
    overflow: hidden;
    transition: 0.3s ease;
    height: 100%;
}

.stat-card::after {
    content: "";
    position: absolute;
    width: 100px;
    height: 100px;
    right: -40px;
    bottom: -45px;
    border-radius: 50%;
    background: rgba(45,212,191,0.07);
    filter: blur(15px);
}

.stat-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,255,255,0.13);
}

.stat-icon {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
}

.stat-icon.blue { background: rgba(59,130,246,0.12); color: #60a5fa; }
.stat-icon.green { background: rgba(34,197,94,0.12); color: #4ade80; }
.stat-icon.orange { background: rgba(245,158,11,0.12); color: #fbbf24; }
.stat-icon.red { background: rgba(239,68,68,0.12); color: #f87171; }

.stat-title {
    margin-top: 16px;
    color: rgba(255,255,255,0.40);
    font-size: 11px;
    font-weight: 500;
}

.stat-number {
    margin-top: 3px;
    font-size: 27px;
    font-weight: 750;
    letter-spacing: -1px;
    color: #ffffff;
}

.stat-card small {
    color: rgba(255,255,255,0.35) !important;
    font-size: 10px;
}

/* PROGRESS */
.progress-stat {
    height: 8px;
    border-radius: 20px;
    background: rgba(255,255,255,0.08);
}

.progress-safe { background: #2dd4bf; }
.progress-warning { background: #f59e0b; }
.progress-danger { background: #ef4444; }

/* ANALYTICS & TABLES */
.analytics-card, .user-card, .file-card {
    background: rgba(255,255,255,0.035);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 17px;
    overflow: hidden;
}

.analytics-card {
    padding: 22px;
    height: 100%;
}

.card-title-custom {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 18px;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 8px;
}

.chart-container {
    position: relative;
    height: 290px;
}

.section-header {
    padding: 22px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
}

.section-header h4 {
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 3px;
    color: #ffffff;
}

.section-header small {
    color: rgba(255,255,255,0.35);
    font-size: 11px;
}

/* TABLES */
.table-custom {
    margin-bottom: 0;
    color: white;
    width: 100%;
}

.table-custom thead th {
    background: rgba(255,255,255,0.055);
    color: rgba(255,255,255,0.70);
    border: none;
    padding: 15px;
    font-size: 10px;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: .5px;
}

.table-custom tbody td {
    padding: 14px 15px;
    vertical-align: middle;
    color: rgba(255,255,255,0.70);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 11px;
}

.table-custom tbody tr:hover {
    background: rgba(255,255,255,0.025);
}

.table-custom strong {
    color: white;
}

/* AVATARS & ICONS */
.avatar-custom {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, rgba(45,212,191,0.15), rgba(139,92,246,0.15));
    color: #5eead4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    margin-right: 10px;
    border: 1px solid rgba(45,212,191,0.10);
    flex-shrink: 0;
}

.file-icon-box {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(45,212,191,0.08);
    color: #5eead4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    margin-right: 8px;
    flex-shrink: 0;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 11px;
    border-radius: 20px;
    font-size: 9px;
    font-weight: 600;
}

.status-active-custom {
    background: rgba(34,197,94,0.10);
    color: #4ade80;
}

.status-inactive-custom {
    background: rgba(239,68,68,0.10);
    color: #f87171;
}

/* SEARCH */
.search-box-custom {
    background: rgba(255,255,255,0.035) !important;
    color: white !important;
    border: 1px solid rgba(255,255,255,0.08) !important;
    font-size: 12px;
}

.search-box-custom::placeholder {
    color: rgba(255,255,255,0.30);
}

.search-box-custom:focus {
    background: rgba(255,255,255,0.05) !important;
    color: white !important;
    border-color: rgba(45,212,191,0.4) !important;
    box-shadow: 0 0 0 .2rem rgba(45,212,191,.08) !important;
}

.input-group-text-custom {
    background: rgba(255,255,255,0.035);
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(255,255,255,0.08);
}
</style>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <!-- =================================================
             PAGE HEADER
        ================================================= -->
        <div class="page-header">
            <div class="page-header-title">
                <div class="page-header-icon">
                    <i class="bi bi-folder-fill"></i>
                </div>
                <div>
                    <h2>File & Storage Analytics</h2>
                    <p>Monitor files, storage usage and individual user activity.</p>
                </div>
            </div>

            <a href="/admin/dashboard" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>

        <!-- =================================================
             ZERO-KNOWLEDGE PRIVACY ARCHITECTURE BANNER
        ================================================= -->
        <div class="card card-custom p-3 mb-4" style="background: rgba(45, 212, 191, 0.06); border-left: 4px solid #2dd4bf;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: rgba(45, 212, 191, 0.15); width: 44px; height: 44px; flex-shrink: 0;">
                    <i class="bi bi-shield-lock-fill fs-4" style="color: #5eead4;"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-white"><i class="bi bi-lock-fill me-1" style="color: #5eead4;"></i> Zero-Knowledge Privacy Architecture Active</h6>
                    <p class="text-muted small mb-0">Under AES-256 end-to-end security compliance, administrators hold telemetry, quota, and moderation quarantine rights. Private file contents are encrypted at rest and can only be decrypted by the account owner.</p>
                </div>
            </div>
        </div>

        <!-- =================================================
             SUMMARY CARDS
        ================================================= -->
        <div class="row g-4">
            <!-- USERS -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="stat-title">Total Users</div>
                    <div class="stat-number"><%= totalUsers %></div>
                </div>
            </div>

            <!-- FILES -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="bi bi-files"></i>
                    </div>
                    <div class="stat-title">Total Files</div>
                    <div class="stat-number"><%= totalFiles %></div>
                </div>
            </div>

            <!-- STORAGE -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="bi bi-hdd-fill"></i>
                    </div>
                    <div class="stat-title">Storage Used</div>
                    <div class="stat-number"><%= totalStorageMB %> MB</div>
                    <small>of <%= totalLimitMB %> MB</small>

                    <div class="progress progress-stat mt-3">
                        <div
                            class="progress-bar <%= storagePercentage >= 90 ? 'progress-danger' : (storagePercentage >= 70 ? 'progress-warning' : 'progress-safe') %>"
                            style="width: <%= storagePercentage %>%"
                        ></div>
                    </div>
                    <small class="d-block mt-1"><%= storagePercentage %>% used</small>
                </div>
            </div>

            <!-- TODAY -->
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon red">
                        <i class="bi bi-cloud-arrow-up-fill"></i>
                    </div>
                    <div class="stat-title">Uploads Today</div>
                    <div class="stat-number"><%= todayUploads %></div>
                    <small><%= totalUploaders %> active uploaders</small>
                </div>
            </div>
        </div>


        <!-- =================================================
             INDIVIDUAL USER STATISTICS
        ================================================= -->
        <div class="user-card mt-4">
            <div class="section-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h4>
                            <i class="bi bi-person-lines-fill" style="color:#5eead4;"></i>
                            Individual User Statistics
                        </h4>
                        <small>Detailed storage and file statistics for every registered user.</small>
                    </div>

                    <div style="min-width:280px;">
                        <div class="input-group">
                            <span class="input-group-text input-group-text-custom">
                                <i class="bi bi-search"></i>
                            </span>
                            <input
                                type="text"
                                id="userSearch"
                                class="form-control search-box-custom"
                                placeholder="Search user or email..."
                            >
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Status</th>
                            <th>Files</th>
                            <th>Used</th>
                            <th>Limit</th>
                            <th>Usage</th>
                            <th>Today</th>
                        </tr>
                    </thead>
                    <tbody id="userTable">
                        <% if (userStatistics && userStatistics.length > 0) { %>
                            <% userStatistics.forEach(u => { 
                                const initial = (u.name || 'U').charAt(0).toUpperCase();
                                const progressClass = u.percentage >= 90 ? 'progress-danger' : (u.percentage >= 70 ? 'progress-warning' : 'progress-safe');
                            %>
                                <tr>
                                    <td><strong>#<%= u.id.toString().slice(-6) %></strong></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="avatar-custom"><%= initial %></span>
                                            <div>
                                                <strong><%= u.name %></strong>
                                                <br>
                                                <small class="text-muted"><%= u.email %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (u.status === 'active') { %>
                                            <span class="status-badge status-active-custom">
                                                <i class="bi bi-check-circle-fill"></i> Active
                                            </span>
                                        <% } else { %>
                                            <span class="status-badge status-inactive-custom">
                                                <i class="bi bi-x-circle-fill"></i> <%= u.status %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td><strong><%= u.files %></strong></td>
                                    <td><%= u.used_mb %> MB</td>
                                    <td><%= u.limit_mb %> MB</td>
                                    <td style="min-width:160px;">
                                        <div class="d-flex justify-content-between mb-1">
                                            <small><%= u.percentage %>%</small>
                                        </div>
                                        <div class="progress progress-stat">
                                            <div class="progress-bar <%= progressClass %>" style="width: <%= u.percentage %>%"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge" style="background: rgba(45,212,191,0.12); color: #5eead4; border: 1px solid rgba(45,212,191,0.12);">
                                            <%= u.today %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <i class="bi bi-people" style="font-size:45px; color: rgba(255,255,255,0.25);"></i>
                                    <h5 class="mt-3 text-muted">No users found</h5>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- =================================================
             ALL FILES
        ================================================= -->
        <div class="file-card mt-4">
            <div class="section-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h4>
                            <i class="bi bi-files" style="color:#5eead4;"></i>
                            All Uploaded Files
                        </h4>
                        <small>View and manage files uploaded by users.</small>
                    </div>

                    <span class="badge p-2" style="background: rgba(45,212,191,0.12); color: #5eead4; border: 1px solid rgba(45,212,191,0.20);">
                        <%= totalFiles %> Files
                    </span>
                </div>
            </div>

            <!-- SEARCH -->
            <div class="p-3">
                <div class="input-group">
                    <span class="input-group-text input-group-text-custom">
                        <i class="bi bi-search"></i>
                    </span>
                    <input
                        type="text"
                        id="fileSearch"
                        class="form-control search-box-custom"
                        placeholder="Search file, owner or folder..."
                    >
                </div>
            </div>

            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>File</th>
                            <th>Owner</th>
                            <th>Folder</th>
                            <th>Size</th>
                            <th>Uploaded</th>
                            <th>Privacy & Action</th>
                        </tr>
                    </thead>
                    <tbody id="fileTable">
                        <% if (files && files.length > 0) { %>
                            <% files.forEach(file => { 
                                const ext = (file.file_extension || '').toLowerCase();
                                let fileIconHtml = '';
                                if (ext === 'pdf') {
                                    fileIconHtml = '<i class="bi bi-file-earmark-pdf-fill" style="color:#f87171;"></i>';
                                } else if (['jpg','jpeg','png','gif','webp','svg'].includes(ext)) {
                                    fileIconHtml = '<i class="bi bi-file-earmark-image-fill" style="color:#60a5fa;"></i>';
                                } else if (['doc','docx','txt','rtf'].includes(ext)) {
                                    fileIconHtml = '<i class="bi bi-file-earmark-word-fill" style="color:#60a5fa;"></i>';
                                } else if (['xls','xlsx','csv'].includes(ext)) {
                                    fileIconHtml = '<i class="bi bi-file-earmark-excel-fill" style="color:#4ade80;"></i>';
                                } else if (['zip','rar','7z','tar','gz'].includes(ext)) {
                                    fileIconHtml = '<i class="bi bi-file-earmark-zip-fill" style="color:#fbbf24;"></i>';
                                } else {
                                    fileIconHtml = '<i class="bi bi-file-earmark-fill" style="color:#94a3b8;"></i>';
                                }

                                const fileSize = file.file_size || 0;
                                let formattedSize = '';
                                if (fileSize >= 1048576) {
                                    formattedSize = (fileSize / 1048576).toFixed(2) + " MB";
                                } else if (fileSize >= 1024) {
                                    formattedSize = (fileSize / 1024).toFixed(2) + " KB";
                                } else {
                                    formattedSize = fileSize + " Bytes";
                                }

                                const dateObj = new Date(file.createdAt);
                                const dateFormatted = dateObj.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' + dateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                            %>
                                <tr>
                                    <td><strong>#<%= file._id.toString().slice(-6) %></strong></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="file-icon-box"><%- fileIconHtml %></span>
                                            <div>
                                                <strong class="text-truncate d-inline-block" style="max-width: 250px;" title="<%= file.original_name %>">
                                                    <%= file.original_name %>
                                                </strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="bi bi-person-circle me-1"></i>
                                        <%= file.user ? file.user.full_name : 'Unknown' %>
                                    </td>
                                    <td>
                                        <i class="bi bi-folder-fill me-1" style="color:#fbbf24;"></i>
                                        <%= file.folder ? file.folder.folder_name : 'My Files' %>
                                    </td>
                                    <td><%= formattedSize %></td>
                                    <td><small class="text-muted"><%= dateFormatted %></small></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-body-secondary text-secondary border border-secondary-subtle d-inline-flex align-items-center gap-1 py-1 px-2" title="Zero-Knowledge Privacy: Encrypted at rest, only owner can decrypt" style="font-size: 0.72rem;">
                                                <i class="bi bi-shield-lock-fill text-info"></i> Encrypted
                                            </span>
                                            <form method="POST" action="/admin/files/force-delete" class="d-inline" onsubmit="return confirm('Move this file to Recycle Bin / Permanent Quarantine?');">
                                                <input type="hidden" name="file_id" value="<%= file._id %>">
                                                <button type="submit" class="btn btn-danger btn-sm py-1 px-2" title="Move to Recycle Bin">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-folder-x" style="font-size:45px; color:rgba(255,255,255,.25);"></i>
                                    <h5 class="mt-3 text-muted">No files uploaded yet.</h5>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="footer text-center py-4 text-muted" style="font-size: 11px;">
            © 2026 File Storage System - Administrative Analytics
        </div>
    </main>
</div>

<!-- =====================================================
     JAVASCRIPT (SEARCH FILTERING)
===================================================== -->
<script>

/* USER SEARCH FILTER */
document.getElementById("userSearch").addEventListener("keyup", function() {
    const search = this.value.toLowerCase();
    const rows = document.querySelectorAll("#userTable tr");
    rows.forEach(function(row) {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(search) ? "" : "none";
    });
});

/* FILE SEARCH FILTER */
document.getElementById("fileSearch").addEventListener("keyup", function() {
    const search = this.value.toLowerCase();
    const rows = document.querySelectorAll("#fileTable tr");
    rows.forEach(function(row) {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(search) ? "" : "none";
    });
});
</script>

<%- include('../partials/footer') %>
