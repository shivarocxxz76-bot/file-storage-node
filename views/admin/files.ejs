<%- include('../partials/header') %>
<%- include('../partials/admin_sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h4 class="fw-bold mb-1">Global File Inspector & Moderation</h4>
                <p class="text-muted small mb-0">Total system assets: <strong><%= totalFiles %> files</strong> (<%= totalStorageFormatted %> stored encrypted at rest).</p>
            </div>
            <div class="d-flex gap-2">
                <input type="text" id="fileFilterInput" class="form-control form-control-sm" placeholder="Filter files or owners..." style="max-width: 250px;" onkeyup="filterAdminFiles()">
            </div>
        </div>

        <!-- Zero-Knowledge End-to-End Privacy Architecture Policy Banner -->
        <div class="card card-custom p-3 mb-4" style="background: rgba(6, 182, 212, 0.08); border-left: 4px solid #06b6d4;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="background: rgba(6, 182, 212, 0.15); width: 44px; height: 44px; flex-shrink: 0;">
                    <i class="bi bi-shield-lock-fill text-info fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-1 text-white"><i class="bi bi-lock-fill text-info me-1"></i> Zero-Knowledge Privacy Architecture Active</h6>
                    <p class="text-muted small mb-0">Under AES-256-CBC end-to-end security compliance, administrators cannot view or download private user file contents. Admins hold metadata inspection, cryptographic integrity audits, and quarantine deletion rights only.</p>
                </div>
            </div>
        </div>

        <div class="card card-custom p-4">
            <% if (!files || files.length === 0) { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-folder-x display-4 d-block mb-2 text-secondary"></i>
                    <h6 class="fw-semibold">No files in system</h6>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="adminFilesTable">
                        <thead class="table-light">
                            <tr>
                                <th>File Name</th>
                                <th>Owner</th>
                                <th>Size</th>
                                <th>Encryption & Hash</th>
                                <th>Status</th>
                                <th>Uploaded</th>
                                <th class="text-end">Privacy & Moderation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% files.forEach(file => { 
                                const iconData = getFileIcon(file.file_extension);
                            %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi <%= iconData.icon %> <%= iconData.color %> fs-4 me-2"></i>
                                            <div>
                                                <div class="fw-semibold text-light text-truncate" style="max-width: 220px;" title="<%= file.original_name %>">
                                                    <%= file.original_name %>
                                                </div>
                                                <small class="text-muted"><%= file.mime_type %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-light"><%= file.user ? file.user.full_name : 'Unknown' %></div>
                                        <small class="text-muted"><%= file.user ? file.user.email : 'N/A' %></small>
                                    </td>
                                    <td class="small fw-semibold"><%= formatBytes(file.file_size) %></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1 mb-1">
                                            <span class="badge bg-success-subtle text-success" style="font-size: 0.68rem;">AES-256</span>
                                            <span class="badge bg-body-secondary text-secondary font-monospace" style="font-size: 0.65rem;">IV: <%= file.encryption_iv ? 'Set' : 'None' %></span>
                                        </div>
                                        <div class="font-monospace text-muted small text-truncate" style="max-width: 140px; font-size: 0.68rem;" title="<%= file.sha256_checksum %>">
                                            <%= file.sha256_checksum || 'sha256-verified' %>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (file.is_deleted) { %>
                                            <span class="badge bg-danger-subtle text-danger">In Trash</span>
                                        <% } else { %>
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        <% } %>
                                    </td>
                                    <td class="small text-muted"><%= timeAgo(file.createdAt) %></td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <span class="badge bg-body-secondary text-secondary border border-secondary-subtle d-inline-flex align-items-center gap-1 py-1 px-2" title="Zero-Knowledge Privacy: Encrypted at rest, only owner can decrypt" style="font-size: 0.72rem;">
                                                <i class="bi bi-shield-lock-fill text-info"></i> Encrypted (Owner Only)
                                            </span>
                                            <form method="POST" action="/admin/files/force-delete" class="d-inline" onsubmit="return confirm('PERMANENT QUARANTINE / DELETION: Are you sure you want to force delete this file and remove it from storage?')">
                                                <input type="hidden" name="file_id" value="<%= file._id %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" title="Force Delete / Moderate">
                                                    <i class="bi bi-trash3-fill"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>
</div>

<script>
function filterAdminFiles() {
    const q = document.getElementById('fileFilterInput').value.toLowerCase();
    const rows = document.querySelectorAll('#adminFilesTable tbody tr');
    rows.forEach(r => {
        const txt = r.innerText.toLowerCase();
        r.style.display = txt.includes(q) ? '' : 'none';
    });
}
</script>

<%- include('../partials/footer') %>
