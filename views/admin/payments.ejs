<%- include('../partials/header') %>
<%- include('../partials/admin_sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h4 class="fw-bold mb-1">Financial & Billing Ledger</h4>
                <p class="text-muted small mb-0">Total recorded transactions: <strong>$<%= totalRevenue %></strong> in demo revenue.</p>
            </div>
            <div class="d-flex gap-2">
                <input type="text" id="paymentFilterInput" class="form-control form-control-sm" placeholder="Search by Txn ID, User..." style="max-width: 250px;" onkeyup="filterPayments()">
            </div>
        </div>

        <div class="card card-custom p-4">
            <% if (!payments || payments.length === 0) { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-cash-stack display-4 d-block mb-2 text-secondary"></i>
                    <h6 class="fw-semibold">No transactions recorded yet</h6>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="adminPaymentsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Txn ID</th>
                                <th>User Account</th>
                                <th>Subscribed Plan</th>
                                <th>Method</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date & Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% payments.forEach(p => { %>
                                <tr>
                                    <td>
                                        <span class="font-monospace fw-semibold text-primary"><%= p.transaction_id %></span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-light"><%= p.user ? p.user.full_name : 'Deleted Account' %></div>
                                        <small class="text-muted"><%= p.user ? p.user.email : 'N/A' %></small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary"><%= p.plan ? p.plan.plan_name : 'Custom Upgrade' %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-body-secondary text-uppercase border text-secondary">
                                            <%= p.payment_method %>
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">$<%= p.amount.toFixed(2) %></td>
                                    <td>
                                        <span class="badge bg-<%= p.status === 'completed' ? 'success' : 'danger' %>-subtle text-<%= p.status === 'completed' ? 'success' : 'danger' %> text-capitalize">
                                            <%= p.status %>
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        <div><%= new Date(p.payment_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                                        <small class="text-muted"><%= timeAgo(p.payment_date) %></small>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </main>
</div>

<script>
function filterPayments() {
    const q = document.getElementById('paymentFilterInput').value.toLowerCase();
    const rows = document.querySelectorAll('#adminPaymentsTable tbody tr');
    rows.forEach(r => {
        const txt = r.innerText.toLowerCase();
        r.style.display = txt.includes(q) ? '' : 'none';
    });
}
</script>

<%- include('../partials/footer') %>
