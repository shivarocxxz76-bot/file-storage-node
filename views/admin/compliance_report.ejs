<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            padding: 30px 20px;
        }
        .report-sheet {
            max-width: 1050px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 40px;
            border: 1px solid #e2e8f0;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        .header-seal {
            border-bottom: 2px solid #0284c7;
            padding-bottom: 25px;
            margin-bottom: 25px;
        }
        .crypto-box {
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            border-left: 4px solid #0284c7;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 30px;
        }
        .table-compliance {
            font-size: 0.85rem;
        }
        .table-compliance th {
            background-color: #0f172a !important;
            color: #ffffff !important;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.75rem;
            padding: 10px 12px;
        }
        .table-compliance td {
            padding: 8px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }
        .badge-event {
            font-size: 0.68rem;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 4px;
        }
        .sig-block {
            border-top: 2px dashed #cbd5e1;
            padding-top: 25px;
            margin-top: 40px;
        }
        .watermark-banner {
            background: linear-gradient(135deg, #0369a1 0%, #0f172a 100%);
            color: #ffffff;
            border-radius: 8px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 25px;
        }
        @media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
            }
            .report-sheet {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                max-width: 100% !important;
            }
            .no-print {
                display: none !important;
            }
            .table-compliance tr {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>

    <!-- Action Toolbar (Hidden in Print/PDF) -->
    <div class="container mb-4 no-print" style="max-width: 1050px;">
        <div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm border gap-2">
            <div class="d-flex align-items-center gap-2">
                <a href="/admin/logs" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                    <i class="bi bi-arrow-left"></i> Back to System Logs
                </a>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-shield-check me-1"></i> Cryptographically Signed
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/admin/logs/export/csv" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1">
                    <i class="bi bi-filetype-csv"></i> Download Signed CSV
                </a>
                <button type="button" onclick="window.print()" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-printer-fill"></i> Save as PDF / Print
                </button>
            </div>
        </div>
    </div>

    <!-- Official Report Document -->
    <div class="report-sheet">

        <!-- Header -->
        <div class="header-seal d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="bg-primary text-white rounded p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                    </div>
                    <h4 class="fw-bold mb-0 text-dark tracking-tight">SECUREVAULT ENTERPRISE</h4>
                </div>
                <div class="text-muted small">Web-Based Secure File Storage & Access Management System</div>
                <div class="fw-semibold text-primary mt-1" style="font-size: 0.85rem;">
                    <i class="bi bi-patch-check-fill me-1"></i> REGULATORY FORENSIC AUDIT TRAIL CERTIFICATE
                </div>
            </div>
            <div class="text-md-end">
                <div class="badge bg-dark px-3 py-2 text-uppercase font-mono mb-1" style="letter-spacing: 1px;">
                    REF: CR-<%= exportId %>
                </div>
                <div class="small text-muted">Classification: <strong>CONFIDENTIAL / COMPLIANCE USE</strong></div>
                <div class="small text-muted">Standard: <strong>ISO/IEC 27001 | SOC-2 | HIPAA</strong></div>
            </div>
        </div>

        <!-- Compliance Banner -->
        <div class="watermark-banner">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-fingerprint fs-2"></i>
                <div>
                    <div class="fw-bold">Digital Certificate of Authenticity & Forensics</div>
                    <div class="small opacity-75">Certified immutable audit trail extracted directly from on-disk WiredTiger database.</div>
                </div>
            </div>
            <div class="text-end font-mono small d-none d-md-block">
                <div>TOTAL RECORDS: <%= totalRecords %></div>
                <div class="opacity-75">STATE: TAMPER-EVIDENT</div>
            </div>
        </div>

        <!-- Audit Metadata Grid -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="text-muted text-uppercase" style="font-size: 0.7rem; font-weight: 600;">Auditor / Administrator</div>
                    <div class="fw-bold text-dark mt-1 text-truncate"><%= adminUser ? adminUser.full_name : 'System Administrator' %></div>
                    <small class="text-muted text-truncate d-block"><%= adminUser ? adminUser.email : 'admin@filestorage.local' %></small>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="text-muted text-uppercase" style="font-size: 0.7rem; font-weight: 600;">Generated Timestamp</div>
                    <div class="fw-bold text-dark mt-1 font-mono" style="font-size: 0.85rem;"><%= exportedAt.toISOString().slice(0, 10) %></div>
                    <small class="text-muted font-mono"><%= exportedAt.toISOString().slice(11, 19) %> UTC</small>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="text-muted text-uppercase" style="font-size: 0.7rem; font-weight: 600;">Total Audit Events</div>
                    <div class="fw-bold text-primary mt-1 fs-5"><%= totalRecords %> <span class="fs-6 fw-normal text-muted">Events</span></div>
                    <small class="text-success"><i class="bi bi-check-circle-fill"></i> 100% Verified</small>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded border">
                    <div class="text-muted text-uppercase" style="font-size: 0.7rem; font-weight: 600;">Audit Scope</div>
                    <div class="fw-bold text-dark mt-1" style="font-size: 0.85rem;">All Standard Users</div>
                    <small class="text-muted">Files, Logins & Shares</small>
                </div>
            </div>
        </div>

        <!-- Cryptographic Proof Block -->
        <div class="crypto-box font-mono small">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong class="text-primary text-uppercase" style="letter-spacing: 0.5px;">
                    <i class="bi bi-key-fill me-1"></i> Cryptographic Audit Verification Signatures
                </strong>
                <span class="badge bg-success">VERIFIED VALID</span>
            </div>
            <div class="text-break mb-1">
                <span class="text-secondary fw-semibold">SHA-256 Checksum:</span> 
                <span class="text-dark"><%= sha256Checksum %></span>
            </div>
            <div class="text-break mb-1">
                <span class="text-secondary fw-semibold">HMAC-SHA256 Digital Signature:</span> 
                <span class="text-primary fw-bold"><%= hmacSignature %></span>
            </div>
            <div class="text-muted" style="font-size: 0.75rem;">
                * Any unauthorized alteration to the records, dates, or IP addresses invalidates the cryptographic HMAC signature above.
            </div>
        </div>

        <!-- Audit Records Table -->
        <div class="table-responsive mb-4">
            <table class="table table-compliance table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width: 14%;">Timestamp (UTC)</th>
                        <th style="width: 18%;">User Subject</th>
                        <th style="width: 15%;">Action Type</th>
                        <th>Event Description</th>
                        <th style="width: 10%;">Category</th>
                        <th style="width: 13%;">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (!logs || logs.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No audit events recorded in database.</td>
                        </tr>
                    <% } else { %>
                        <% logs.forEach((log) => { 
                            let badgeStyle = 'background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;';
                            if (log.action_type.includes('DELETE') || log.action_type.includes('PURGE')) {
                                badgeStyle = 'background-color: #fee2e2; color: #b91c1c; border: 1px solid #fecaca;';
                            } else if (log.action_type.includes('LOGIN') || log.action_type.includes('REGISTER')) {
                                badgeStyle = 'background-color: #dcfce7; color: #15803d; border: 1px solid #bbf7d0;';
                            } else if (log.action_type.includes('SHARE')) {
                                badgeStyle = 'background-color: #fef3c7; color: #b45309; border: 1px solid #fde68a;';
                            }
                        %>
                            <tr>
                                <td class="font-mono text-muted" style="font-size: 0.75rem;">
                                    <%= new Date(log.createdAt).toISOString().replace('T', ' ').slice(0, 19) %>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark" style="font-size: 0.8rem;"><%= log.user ? log.user.full_name : 'System / Guest' %></div>
                                    <div class="text-muted" style="font-size: 0.72rem;"><%= log.user ? log.user.email : 'N/A' %></div>
                                </td>
                                <td>
                                    <span class="badge-event font-mono" style="<%= badgeStyle %>"><%= log.action_type %></span>
                                </td>
                                <td>
                                    <div class="text-dark" style="font-size: 0.8rem;"><%= log.description %></div>
                                    <% if (log.resource_id) { %>
                                        <div class="font-mono text-muted" style="font-size: 0.68rem;">ID: <%= log.resource_id %></div>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary text-uppercase" style="font-size: 0.65rem;">
                                        <%= log.resource_type || 'system' %>
                                    </span>
                                </td>
                                <td class="font-mono text-muted" style="font-size: 0.75rem;">
                                    <%= log.ip_address || '127.0.0.1' %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Attestation Signature & Seal -->
        <div class="sig-block">
            <div class="row g-4 align-items-center">
                <div class="col-md-7">
                    <h6 class="fw-bold mb-1 text-dark">Regulatory Attestation & Non-Repudiation</h6>
                    <p class="text-muted small mb-0" style="font-size: 0.78rem;">
                        This document certifies that the event records enumerated herein were captured automatically by the SecureVault system audit filter in real-time. Records are immutable, cryptographically sealed with HMAC-SHA256, and stored persistently in MongoDB using the WiredTiger journal-backed storage engine.
                    </p>
                </div>
                <div class="col-md-5 text-md-end">
                    <div class="d-inline-block border p-3 rounded text-center bg-light" style="min-width: 240px;">
                        <div class="text-primary fw-bold font-mono small mb-1">
                            <i class="bi bi-shield-check me-1"></i> DIGITALLY ATTESTED
                        </div>
                        <div class="fw-bold text-dark"><%= adminUser ? adminUser.full_name : 'System Administrator' %></div>
                        <div class="text-muted small" style="font-size: 0.7rem;">Platform Security Officer</div>
                        <div class="font-mono text-muted mt-2" style="font-size: 0.68rem;">
                            Cert ID: <%= exportId %> | <%= exportedAt.toISOString().slice(0, 10) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
