<%- include('../partials/header') %>
<%- include('../partials/admin_sidebar') %>

<div class="main-content">
    <%- include('../partials/topbar') %>

    <main class="page-body">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h4 class="fw-bold mb-1">Helpdesk & Support Management</h4>
                <p class="text-muted small mb-0">Respond to user inquiries, resolve tickets, and manage platform support requests.</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left: All Tickets List -->
            <div class="col-lg-4">
                <div class="card card-custom p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                        <h6 class="fw-bold mb-0"><i class="bi bi-inbox-fill text-primary me-2"></i>Tickets (<%= allTickets.length %>)</h6>
                    </div>

                    <% if (!allTickets || allTickets.length === 0) { %>
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                            <p class="small">No customer tickets submitted.</p>
                        </div>
                    <% } else { %>
                        <div class="list-group list-group-flush" style="max-height: 550px; overflow-y: auto;">
                            <% allTickets.forEach(t => { 
                                const isSelected = activeTicket && activeTicket._id.toString() === t._id.toString();
                                let statusClass = 'bg-primary-subtle text-primary';
                                if (t.status === 'in_progress') statusClass = 'bg-warning-subtle text-warning';
                                else if (t.status === 'resolved') statusClass = 'bg-success-subtle text-success';
                                else if (t.status === 'closed') statusClass = 'bg-secondary-subtle text-secondary';
                            %>
                                <a href="/admin/support?ticket_id=<%= t._id %>" class="list-group-item list-group-item-action p-3 rounded mb-2 <%= isSelected ? 'border-primary bg-primary-subtle bg-opacity-25' : 'border' %>">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold mb-0 text-truncate" style="max-width: 170px;"><%= t.subject %></h6>
                                        <span class="badge <%= statusClass %> text-capitalize" style="font-size: 0.68rem;"><%= t.status.replace('_', ' ') %></span>
                                    </div>
                                    <div class="small text-muted mb-1 text-truncate">
                                        From: <strong><%= t.user ? t.user.full_name : 'Deleted User' %></strong>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center small text-muted">
                                        <span class="badge bg-body-secondary text-secondary text-uppercase" style="font-size: 0.65rem;"><%= t.priority %></span>
                                        <span style="font-size: 0.72rem;"><%= timeAgo(t.createdAt) %></span>
                                    </div>
                                </a>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right: Active Ticket Thread -->
            <div class="col-lg-8">
                <% if (!activeTicket) { %>
                    <div class="card card-custom p-5 text-center text-muted">
                        <i class="bi bi-chat-dots display-3 text-secondary mb-3 d-block"></i>
                        <h5 class="fw-bold">Select a Support Ticket</h5>
                        <p class="small text-muted mb-0">Click on any ticket from the inbox on the left to read user messages and reply.</p>
                    </div>
                <% } else { %>
                    <div class="card card-custom p-4">
                        <!-- Ticket Header & Status Control -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start border-bottom pb-3 mb-4 gap-3">
                            <div>
                                <h5 class="fw-bold mb-1"><%= activeTicket.subject %></h5>
                                <div class="d-flex gap-2 align-items-center small text-muted flex-wrap">
                                    <span>Requester: <strong><%= activeTicket.user ? activeTicket.user.full_name : 'Unknown' %> (<%= activeTicket.user ? activeTicket.user.email : 'N/A' %>)</strong></span>
                                    <span>•</span>
                                    <span class="badge bg-secondary-subtle text-secondary text-uppercase"><%= activeTicket.priority %> Priority</span>
                                    <span>•</span>
                                    <span><%= timeAgo(activeTicket.createdAt) %></span>
                                </div>
                            </div>
                            
                            <!-- Status Update Form -->
                            <form method="POST" action="/admin/support/status" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="ticket_id" value="<%= activeTicket._id %>">
                                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="open" <%= activeTicket.status === 'open' ? 'selected' : '' %>>Open</option>
                                    <option value="in_progress" <%= activeTicket.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                                    <option value="resolved" <%= activeTicket.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                                    <option value="closed" <%= activeTicket.status === 'closed' ? 'selected' : '' %>>Closed</option>
                                </select>
                            </form>
                        </div>

                        <!-- Conversation Thread -->
                        <div class="conversation-thread mb-4" style="max-height: 380px; overflow-y: auto;">
                            <% ticketReplies.forEach(reply => { 
                                const isAdmin = reply.is_admin_reply;
                            %>
                                <div class="d-flex mb-3 gap-3 <%= isAdmin ? 'flex-row-reverse' : 'flex-row' %>">
                                    <div class="avatar-circle <%= isAdmin ? 'bg-danger text-white' : 'bg-primary text-white' %> d-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 38px; height: 38px;">
                                        <i class="bi <%= isAdmin ? 'bi-shield-check' : 'bi-person' %>"></i>
                                    </div>
                                    <div class="p-3 rounded-3 <%= isAdmin ? 'bg-danger-subtle text-dark border border-danger-subtle' : 'bg-body-secondary border' %> shadow-sm" style="max-width: 75%;">
                                        <div class="d-flex justify-content-between align-items-center gap-3 mb-1">
                                            <strong class="small <%= isAdmin ? 'text-danger fw-bold' : 'text-primary' %>">
                                                <%= reply.user ? reply.user.full_name : (isAdmin ? 'Admin' : 'User') %> <%= isAdmin ? '(Administrator Response)' : '' %>
                                            </strong>
                                            <span class="small text-muted" style="font-size: 0.72rem;"><%= timeAgo(reply.createdAt) %></span>
                                        </div>
                                        <div class="small text-break"><%= reply.message %></div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Admin Reply Form -->
                        <form method="POST" action="/support/reply" class="border-top pt-3">
                            <input type="hidden" name="ticket_id" value="<%= activeTicket._id %>">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Send Official Staff Reply</label>
                                <textarea name="message" class="form-control" rows="3" placeholder="Provide instructions, status updates, or resolutions to the user..." required></textarea>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">Sending reply will automatically set ticket status to <strong>In Progress</strong>.</span>
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="bi bi-send me-1"></i> Send Reply
                                </button>
                            </div>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
